generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = "file:./dev.db"
}

model FinanceTransaction {
  id        String   @id @default(uuid())
  type      String   // "income" or "expense"
  amount    Float
  label     String
  createdAt DateTime @default(now())

  @@map("finance_transactions")
}
